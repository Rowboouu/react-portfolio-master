# Copy to .env.local (or set these in the Vercel project settings) and fill in.
# .env / .env.local are gitignored — never commit real keys.

# --- Chat assistant (Google Gemini) ---------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash (best tool-calling per dollar here).
# Cheaper alternative: gemini-3.5-flash-lite — 5x cheaper on input, which
# dominates this workload, but weaker at the multi-turn meeting-booking flow.
GEMINI_MODEL=

# --- Email delivery (Resend) ---------------------------------------------
# Powers both the contact form and the chat assistant's meeting requests.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where submissions are delivered. Defaults to contactConfig.YOUR_EMAIL_1.
CONTACT_TO_EMAIL=

# Sender address. Defaults to "Portfolio <onboarding@resend.dev>", Resend's
# shared sender, which needs no domain setup but only delivers to the email
# that owns the Resend account. Once a domain is verified in Resend, switch
# this to something like "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=

# --- Site metadata --------------------------------------------------------
# Optional. Used for absolute OG/canonical URLs; auto-detected on Vercel.
NEXT_PUBLIC_SITE_URL=
